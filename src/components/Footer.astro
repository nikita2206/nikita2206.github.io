---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Nikita.</p>
	<p class="subtle">Built with Astro. Hosted on GitHub Pages.</p>
</footer>
<style>
	footer {
		padding: 3rem 1rem 5rem;
		color: rgb(var(--gray));
		text-align: center;
	}

	footer p {
		margin: 0.25rem 0;
	}

	.subtle {
		font-size: 0.95rem;
	}
</style>
