---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Nikita</p>
</footer>
<style>
	footer {
		padding: 3rem 1.25rem 4rem;
		color: var(--muted);
		text-align: left;
		max-width: 64rem;
		margin: 0 auto;
		border-top: 1px solid color-mix(in oklab, var(--line) 80%, white);
	}

	footer p {
		margin: 0.2rem 0;
	}
</style>
