---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="utility-bar">
		<nav aria-label="Utility">
			<div class="internal-links">
				<HeaderLink href="/">Posts</HeaderLink>
				<HeaderLink href="/archive">Archive</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</nav>
	</div>
	<div class="masthead">
		<h2><a href="/">{SITE_TITLE}</a></h2>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 252, 247, 0.84);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(var(--gray), 0.12);
	}

	.utility-bar {
		padding: 0 1rem;
		border-bottom: 1px solid rgba(var(--gray), 0.1);
	}

	.utility-bar nav,
	.masthead {
		max-width: 960px;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 0.85rem;
		padding: 0.45rem 0;
	}

	.utility-bar a {
		padding: 0;
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.utility-bar a.active,
	.utility-bar a:hover {
		color: rgb(var(--black));
		border-bottom-color: rgba(var(--black), 0.6);
	}

	.masthead {
		padding: 0.85rem 1rem 0.95rem;
	}

	h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	h2 a,
	h2 a.active {
		color: rgb(var(--black));
		text-decoration: none;
	}

	@media (max-width: 560px) {
		.internal-links {
			gap: 0.65rem;
			flex-wrap: wrap;
		}
	}
</style>
