---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="utility-bar">
		<nav aria-label="Utility">
			<div class="internal-links">
				<HeaderLink href="/">Posts</HeaderLink>
				<HeaderLink href="/archive">Archive</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</nav>
	</div>
	<div class="masthead">
		<h2><a href="/">{SITE_TITLE}</a></h2>
	</div>
</header>
<style>
	header {
		background: var(--paper);
		border-bottom: 1px solid color-mix(in oklab, var(--line) 84%, white);
	}

	.utility-bar {
		padding: 0 1.25rem;
	}

	.utility-bar nav,
	.masthead {
		max-width: 64rem;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 0.75rem;
		padding: 0.55rem 0;
	}

	.utility-bar a {
		padding: 0;
		font-size: 0.9rem;
		color: var(--muted);
		text-decoration: none;
	}

	.utility-bar a.active,
	.utility-bar a:hover {
		color: var(--ink);
	}

	.masthead {
		display: none;
	}

	h2 a,
	h2 a.active {
		color: var(--ink);
		text-decoration: none;
	}

	@media (max-width: 640px) {
		.internal-links {
			gap: 0.7rem;
			flex-wrap: wrap;
		}
	}
</style>
