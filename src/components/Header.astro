---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="utility-bar">
		<nav aria-label="Utility">
			<div class="internal-links">
				<HeaderLink href="/">Posts</HeaderLink>
				<HeaderLink href="/archive">Archive</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</nav>
	</div>
	<div class="masthead">
		<p class="kicker">Notes, fragments, dispatches</p>
		<h2><a href="/">{SITE_TITLE}</a></h2>
	</div>
</header>
<style>
	header {
		background: var(--paper);
		border-bottom: 1px solid color-mix(in oklab, var(--line) 84%, white);
	}

	.utility-bar {
		padding: 0 1.25rem;
		border-bottom: 1px solid color-mix(in oklab, var(--line) 88%, white);
	}

	.utility-bar nav,
	.masthead {
		max-width: 64rem;
		margin: 0 auto;
	}

	.internal-links {
		display: flex;
		gap: 0.9rem;
		padding: 0.45rem 0;
	}

	.utility-bar a {
		padding: 0;
		font-size: 0.74rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.utility-bar a.active,
	.utility-bar a:hover {
		color: var(--ink);
		border-bottom-color: color-mix(in oklab, var(--accent) 22%, var(--ink));
	}

	.masthead {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		padding: 0.8rem 1.25rem 0.9rem;
	}

	.kicker {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.2rem, 2vw, 1.8rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	h2 a,
	h2 a.active {
		color: var(--ink);
		text-decoration: none;
	}

	@media (max-width: 640px) {
		.masthead {
			flex-direction: column;
			align-items: flex-start;
		}

		.internal-links {
			gap: 0.7rem;
			flex-wrap: wrap;
		}
	}
</style>
