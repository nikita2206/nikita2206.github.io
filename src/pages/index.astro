---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPost = posts[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Personal blog</p>
				<h1>Small posts. Clear opinions. No sludge.</h1>
				<p class="lede">
					A simple place for notes, links, ideas, and the occasional longer write-up.
				</p>
			</section>

			{latestPost && (
				<section class="latest">
					<p class="section-label">Latest</p>
					<article>
						<h2><a href={`/blog/${latestPost.id}/`}>{latestPost.data.title}</a></h2>
						<p class="meta">
							<FormattedDate date={latestPost.data.pubDate} />
						</p>
						<p>{latestPost.data.description}</p>
					</article>
				</section>
			)}

			<section>
				<p class="section-label">Recent posts</p>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="post-link">
								<div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 1rem;
	}

	.eyebrow,
	.section-label,
	.meta {
		font-size: 0.95rem;
		color: rgb(var(--gray));
	}

	.eyebrow,
	.section-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	h1 {
		max-width: 12ch;
		margin-bottom: 0.5rem;
	}

	.lede {
		max-width: 42rem;
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
	}

	.latest {
		margin: 2.5rem 0;
		padding: 1.5rem;
		border: 1px solid rgba(var(--gray), 0.18);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(10px);
	}

	.latest h2,
	.post-list h3 {
		margin-bottom: 0.35rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.post-link {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
		padding: 1rem 0;
		border-bottom: 1px solid rgba(var(--gray), 0.14);
		text-decoration: none;
		color: inherit;
	}

	.post-link:hover h3 {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.post-link p {
		margin: 0;
		color: rgb(var(--gray-dark));
	}

	.post-date {
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	@media (max-width: 720px) {
		.post-link {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
