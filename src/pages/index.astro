---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pageSize = 10;
const firstPagePosts = posts.slice(0, pageSize);
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Posts</h1>
			<ul class="posts">
				{firstPagePosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<div>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</div>
							<span><FormattedDate date={post.data.pubDate} /></span>
						</a>
					</li>
				))}
			</ul>

			{totalPages > 1 && (
				<nav class="pagination" aria-label="Pagination">
					<span class="current">Page 1</span>
					<a href="/page/2/" rel="next">Older posts</a>
				</nav>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.posts {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.posts li {
		border-bottom: 1px solid rgba(var(--gray), 0.14);
	}

	.posts a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0;
		text-decoration: none;
		color: inherit;
	}

	.posts h2 {
		font-size: 1.35rem;
		margin-bottom: 0.25rem;
	}

	.posts p,
	.posts span {
		color: rgb(var(--gray));
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(var(--gray), 0.14);
	}

	.current {
		color: rgb(var(--gray));
	}

	@media (max-width: 720px) {
		.posts a,
		.pagination {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
