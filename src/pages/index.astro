---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [leadPost, ...restPosts] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="label">Latest writing</p>
				<h1>Posts</h1>
				<p class="deck">
					A running file of notes, observations, links, and the occasional thing that needed more room.
				</p>
			</section>

			{leadPost && (
				<article class="lead-post">
					<p class="lead-meta"><FormattedDate date={leadPost.data.pubDate} /></p>
					<h2><a href={`/blog/${leadPost.id}/`}>{leadPost.data.title}</a></h2>
					<p class="lead-description">{leadPost.data.description}</p>
				</article>
			)}

			<ul class="posts">
				{restPosts.map((post, index) => (
					<li class:list={{ odd: index % 2 === 0 }}>
						<a href={`/blog/${post.id}/`}>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							<div class="post-body">
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		display: grid;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.label,
	.lead-meta,
	.post-date {
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.deck {
		max-width: 38rem;
		font-size: 1.1rem;
		color: var(--ink-soft);
	}

	.lead-post {
		margin: 0 0 3rem;
		padding: 0 0 2rem;
		border-bottom: 1px solid color-mix(in oklab, var(--line) 84%, white);
	}

	.lead-post h2 {
		font-size: clamp(2rem, 4.8vw, 4rem);
		max-width: 12ch;
		margin: 0.35rem 0 0.65rem;
	}

	.lead-description {
		max-width: 34rem;
		font-size: 1.08rem;
		color: var(--ink-soft);
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.posts li {
		border-top: 1px solid color-mix(in oklab, var(--line) 84%, white);
	}

	.posts a {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 1.25rem;
		padding: 1.15rem 0;
		text-decoration: none;
		color: inherit;
	}

	.post-body {
		max-width: 40rem;
	}

	.posts h3 {
		margin-bottom: 0.2rem;
	}

	.posts p {
		margin: 0;
		color: var(--ink-soft);
	}

	.posts li.odd .post-body {
		padding-left: 1.2rem;
	}

	.posts a:hover h3,
	.lead-post a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.posts a {
			grid-template-columns: 1fr;
			gap: 0.45rem;
		}

		.posts li.odd .post-body {
			padding-left: 0;
		}
	}
</style>
