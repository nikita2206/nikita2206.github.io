---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const years = [...new Set(posts.map((post) => String(post.data.pubDate.getUTCFullYear())))];

	return years.map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const posts = (await getCollection('blog'))
	.filter((post) => String(post.data.pubDate.getUTCFullYear()) === year)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${year} Archive | ${SITE_TITLE}`} description={`Posts from ${year}.`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{year}</h1>
			<p><a href="/archive/">All archives</a></p>
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<div>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</div>
							<span><FormattedDate date={post.data.pubDate} /></span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.posts {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.posts li {
		border-bottom: 1px solid rgba(var(--gray), 0.14);
	}

	.posts a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0;
		text-decoration: none;
		color: inherit;
	}

	.posts h2 {
		font-size: 1.35rem;
		margin-bottom: 0.25rem;
	}

	.posts p,
	.posts span {
		color: rgb(var(--gray));
	}

	@media (max-width: 720px) {
		.posts a {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
