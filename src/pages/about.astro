---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p class="kicker">About</p>
			<h1>Nikita</h1>
			<p>
				This is a small blog for posting things that are actually worth posting: notes,
				opinions, links, experiments, and occasional longer pieces.
			</p>
			<p>
				It is intentionally simple. Write in Markdown, push to GitHub, done.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.95rem;
		font-weight: 700;
		color: rgb(var(--gray));
	}
</style>
