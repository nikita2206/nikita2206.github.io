---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p class="label">Colophon</p>
			<h1>About</h1>
			<div class="copy">
				<p>
					This is Nikita’s small corner of the internet for short posts, stray thoughts,
					links, experiments, and whatever else deserves a page instead of a disappearing scroll.
				</p>
				<p>
					It is deliberately lightweight: write in Markdown, commit, push, done.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.label {
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.78rem;
		color: var(--muted);
	}

	.copy {
		max-width: 42rem;
	}
</style>
